{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "testmate",
  "compatibility_date": "2026-11-03",
  "main": "./worker/index.ts",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "testmate",
      "database_id": "824b73b7-5e83-41a5-8298-40c5d7b7716c",
      "migrations_dir": "drizzle",
    },
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
  },
  "routes": [
    {
      "pattern": "testmate.xin-ping.com",
      "custom_domain": true,
    },
  ],
  "env": {
    "dev": {
      "workers_dev": false,
      "preview_urls": false,
      // Not inherited from the top level. Placeholder id, the same as above:
      // replace it with the id from `wrangler d1 create testmate-dev`.
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "testmate-dev",
          "database_id": "97ee33d9-4b87-4aa1-a87c-6152f2ff12c6",
          "migrations_dir": "drizzle",
        },
      ],
      "routes": [
        {
          "pattern": "dev-testmate.xin-ping.com",
          "custom_domain": true,
        },
      ],
    },
  },
}
