{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "testmate",
  "compatibility_date": "2026-11-03",
  "pages_build_output_dir": "./dist",
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
}
