{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "testmate",
  "compatibility_date": "2026-11-03",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "routes": [{ "pattern": "testmate.xin-ping.com", "custom_domain": true }],
  "env": {
    "dev": {
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        { "pattern": "dev-testmate.xin-ping.com", "custom_domain": true },
      ],
    },
  },
}
